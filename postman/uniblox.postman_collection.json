{
  "info": {
    "name": "Uniblox Checkout API",
    "description": "Run \"List products\" first (saves {{productId}} and {{deskMatId}}), then \"Create cart\" (saves {{cartId}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "cartId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "couponCode",
      "value": ""
    },
    {
      "key": "deskMatId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const products = pm.response.json();",
                  "pm.collectionVariables.set(\"productId\", products.find(p => p.name === \"Mechanical Keyboard\").id);",
                  "pm.collectionVariables.set(\"deskMatId\", products.find(p => p.name === \"Limited Edition Desk Mat\").id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Carts",
      "item": [
        {
          "name": "Create cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('cartId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts"
          }
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/carts/{{cartId}}"
          }
        },
        {
          "name": "Add item",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts/{{cartId}}/items",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            }
          }
        },
        {
          "name": "Update item quantity",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/carts/{{cartId}}/items/{{productId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            }
          }
        },
        {
          "name": "Remove item",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/carts/{{cartId}}/items/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Checkout cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts/{{cartId}}/checkout"
          }
        },
        {
          "name": "Checkout cart with coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts/{{cartId}}/checkout",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"couponCode\": \"{{couponCode}}\"\n}"
            }
          }
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Generate coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"couponCode\", pm.response.json().code);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/coupons"
          }
        },
        {
          "name": "List coupons",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/coupons"
          }
        },
        {
          "name": "Report",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/report"
          }
        }
      ]
    },
    {
      "name": "Error examples",
      "item": [
        {
          "name": "Unknown product (404 PRODUCT_NOT_FOUND)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts/{{cartId}}/items",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"00000000-0000-4000-8000-000000000000\",\n  \"quantity\": 1\n}"
            }
          }
        },
        {
          "name": "Invalid quantity (400 VALIDATION_ERROR)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts/{{cartId}}/items",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 0\n}"
            }
          }
        },
        {
          "name": "More than in stock (409 INSUFFICIENT_STOCK)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts/{{cartId}}/items",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{deskMatId}}\",\n  \"quantity\": 4\n}"
            }
          }
        },
        {
          "name": "Unknown cart (404 CART_NOT_FOUND)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/carts/00000000-0000-4000-8000-000000000000"
          }
        },
        {
          "name": "Checkout same cart again (409 CART_ALREADY_CHECKED_OUT)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts/{{cartId}}/checkout"
          }
        },
        {
          "name": "Unknown order (404 ORDER_NOT_FOUND)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders/00000000-0000-4000-8000-000000000000"
          }
        },
        {
          "name": "Unknown coupon (404 COUPON_NOT_FOUND)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/carts/{{cartId}}/checkout",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"couponCode\": \"NOPE\"\n}"
            }
          }
        }
      ]
    }
  ]
}
