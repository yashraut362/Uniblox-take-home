generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  priceCents Int
  stock      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cartItems  CartItem[]
  orderItems OrderItem[]
}

enum CartStatus {
  OPEN
  CHECKED_OUT
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  status    CartStatus @default(OPEN)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items CartItem[]
  order Order?
}

model CartItem {
  cartId    String @db.Uuid
  productId Int
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([cartId, productId])
}

model Order {
  id            String   @id @default(uuid()) @db.Uuid
  cartId        String   @unique @db.Uuid
  couponId      Int?     @unique
  subtotalCents Int
  discountCents Int      @default(0)
  totalCents    Int
  createdAt     DateTime @default(now())

  cart   Cart        @relation(fields: [cartId], references: [id])
  coupon Coupon?     @relation(fields: [couponId], references: [id])
  items  OrderItem[]
}

enum CouponStatus {
  AVAILABLE
  REDEEMED
}

model Coupon {
  id         Int          @id @default(autoincrement())
  code       String       @unique
  percent    Int
  milestone  Int          @unique
  status     CouponStatus @default(AVAILABLE)
  createdAt  DateTime     @default(now())
  redeemedAt DateTime?

  order Order?
}

model OrderItem {
  orderId        String @db.Uuid
  productId      Int
  productName    String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
}
